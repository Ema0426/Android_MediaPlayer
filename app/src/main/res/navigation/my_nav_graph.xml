<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/my_nav_graph"
    app:startDestination="@id/welcomeFragment">

    <fragment
        android:id="@+id/welcomeFragment"
        android:name="com.example.mediaplayer.ui.WelcomeFragment"
        android:label="Welcome"
        tools:layout="@layout/fragment_welcome">

        <action
            android:id="@+id/welcomeFragment_to_libraryFragment"
            app:destination="@+id/libraryFragment"
            app:popUpTo="@id/welcomeFragment"
            />
    </fragment>

    <fragment
        android:id="@+id/libraryFragment"
        android:name="com.example.mediaplayer.ui.LibraryFragment"
        android:label="@string/libreria"
        tools:layout="@layout/fragment_library">

        <action
            android:id="@+id/libraryFragment_to_playerFragment"
            app:destination="@+id/playerFragment"
            />
    </fragment>

    <fragment
        android:id="@+id/playerFragment"
        android:name="com.example.mediaplayer.ui.PlayerFragment"
        android:label="Player"
        tools:layout="@layout/fragment_player">
    </fragment>

    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.example.mediaplayer.ui.FavoritesFragment"
        android:label="@string/preferiti"
        tools:layout="@layout/fragment_favorites">

        <action
            android:id="@+id/action_favoritesFragment_to_playerFragment"
            app:destination="@id/playerFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim" />
    </fragment>

    <action android:id="@+id/action_global_WelcomeFragment"
        app:destination="@id/welcomeFragment"
        app:popUpTo="@id/my_nav_graph"
        app:popUpToInclusive="true"/>
</navigation>

    <!-- Questo file conterrà la mappa di tutti i Fragment definiti in precedenza
    e le azioni (arrows) per spostarsi tra di essi, configurando il plugin Safe Args
     affinché il click su una canzone nella libreria passi in modo tipizzato e sicuro l'ID del brano al PlayerFragment. -->